# Official Docker Library Python metadata, resolved read-only on 2026-10-30 MYT:
# https://hub.docker.com/_/python
# index 229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36
# linux/amd64 manifest below; upstream docker-library/python revision
# 3362634339580d3232e65a66dd5a36c47ae7ff14, 3.12/slim-trixie.
FROM python:3.12.13-slim@sha256:d657ab0ade19f404a6ccc883ab399540de667aff751748ce23c07330c5a89e64
RUN pip install --no-cache-dir uv==0.11.25
WORKDIR /workspace
COPY pyproject.toml uv.lock ./
ENV UV_PROJECT_ENVIRONMENT=/opt/app-venv UV_PYTHON_DOWNLOADS=never
RUN uv sync --locked --no-dev --no-install-project --python /usr/local/bin/python3.12
COPY src ./src
COPY targets ./targets
COPY migrations ./migrations
COPY alembic.ini ./
COPY tests/integration/planner_process_fixture.py ./tests/integration/planner_process_fixture.py
COPY ci-source-manifest.json ./ci-source-manifest.json
ENV PATH="/opt/app-venv/bin:${PATH}" PYTHONPATH=/workspace/src PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN uv sync --locked --no-dev --python /usr/local/bin/python3.12
ENTRYPOINT []
CMD ["python", "tests/integration/planner_process_fixture.py", "--role", "controller"]
