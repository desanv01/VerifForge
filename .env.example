# Local development only. No model credentials are needed for deterministic RTL.
COMPOSE_PROJECT_NAME=veriforge-local
VERIFORGE_API_PORT=18000
VERIFORGE_POSTGRES_PASSWORD=veriforge-local-only
VERIFORGE_RTL_IMAGE=veriforge-rtl:dev
VERIFORGE_APP_IMAGE=veriforge-app:local
# Optional future API/planner-only configuration. Compose does not forward these
# into the shared app environment or RTL worker. Never place real keys here.
# MODEL_API_KEY=
# VERIFORGE_META_MODEL=muse-spark-1.3
